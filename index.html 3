<style>
/* ============================================================================
   APEXGPT — DESIGN TOKEN SYSTEM
   ============================================================================ */
:root {
  --bg-root:      #080a0f;
  --bg-panel:     #10131a;
  --bg-panel-2:   #161a24;
  --bg-hover:     #1e2330;
  --bg-msg-user:  #141821;
  --bg-msg-ai:    #0f121a;

  --border:       #232838;
  --border-soft:  #191d28;
  --border-hi:    #333b4d;

  --text-hi:      #f2f4f9;
  --text-mid:     #9aa4ba;
  --text-lo:      #5a6378;

  --accent:       #10a37f;
  --accent-2:     #0d8a6b;
  --accent-glow:  rgba(16, 163, 127, 0.28);
  --purple:       #6d4aff;
  --purple-glow:  rgba(109, 74, 255, 0.28);

  --danger:       #ff5c7c;
  --warn:         #f5b544;
  --ok:           #4ade80;

  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 14px;

  --shadow-1: 0 2px 8px rgba(0,0,0,0.3);
  --shadow-2: 0 8px 24px rgba(0,0,0,0.45);
  --shadow-3: 0 20px 60px rgba(0,0,0,0.6);

  --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

  --pill-bg: #2f2f2f;
  --pill-border: rgba(255,255,255,0.08);
  --pill-radius: 24px;
  --pill-radius-expanded: 20px;
  --pill-shadow: 0 12px 40px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.03);
  --pill-shadow-focus: 0 16px 52px rgba(0,0,0,0.65), 0 0 0 1px rgba(16,163,127,0.35);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%;
  overflow: hidden;
  background: var(--bg-root);
  color: var(--text-hi);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ============================================================================
   APP SHELL
   ============================================================================ */
.app-shell {
  display: grid;
  grid-template-columns: 300px 1fr;
  width: 100vw; height: 100vh;
  background:
    radial-gradient(1000px 600px at 90% -10%, rgba(109,74,255,0.07), transparent 60%),
    radial-gradient(800px 500px at -10% 110%, rgba(16,163,127,0.06), transparent 60%),
    var(--bg-root);
}

/* ============================================================================
   SIDEBAR
   ============================================================================ */
.sidebar {
  background: linear-gradient(180deg, #0c0f15 0%, #080a0f 100%);
  border-right: 1px solid var(--border-soft);
  display: flex; flex-direction: column;
  padding: 16px 12px;
  min-height: 0;
  z-index: 20;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.brand {
  display: flex; align-items: center; gap: 10px;
  padding: 4px 8px 16px;
}
.brand-mark {
  width: 34px; height: 34px; border-radius: 10px;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: grid; place-items: center;
  box-shadow: 0 0 24px var(--accent-glow), 0 0 24px var(--purple-glow);
  color: white; font-size: 15px;
  flex-shrink: 0;
}
.brand-text { line-height: 1.2; }
.brand-name {
  font-size: 14px; font-weight: 800; letter-spacing: 0.3px;
  background: linear-gradient(90deg, var(--text-hi), #a8b4ff);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.brand-sub {
  font-size: 9px; color: var(--text-lo);
  text-transform: uppercase; letter-spacing: 1.2px; font-weight: 600;
}

.new-chat-btn {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 11px 14px; margin-bottom: 16px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border: none; border-radius: var(--r-md);
  color: white; font-size: 13px; font-weight: 600;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(16,163,127,0.32);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.new-chat-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 26px rgba(16,163,127,0.45);
}
.new-chat-btn:active { transform: translateY(0); }

.telemetry {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 12px;
  margin-bottom: 16px;
  font-family: var(--mono);
}
.telemetry-title {
  font-size: 9.5px; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--text-lo); margin-bottom: 10px;
  display: flex; align-items: center; gap: 6px;
  font-family: var(--sans); font-weight: 600;
}
.telemetry-title .pulse-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--ok);
  box-shadow: 0 0 8px var(--ok);
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.meter { margin-bottom: 10px; }
.meter:last-child { margin-bottom: 0; }
.meter-head {
  display: flex; justify-content: space-between; align-items: baseline;
  font-size: 10.5px; color: var(--text-mid); margin-bottom: 5px;
  font-family: var(--sans);
}
.meter-label { letter-spacing: 0.3px; }
.meter-value { color: var(--accent); font-weight: 700; font-family: var(--mono); }
.meter-value.warn   { color: var(--warn); }
.meter-value.danger { color: var(--danger); }

.meter-bar {
  height: 4px; background: var(--border);
  border-radius: 2px; overflow: hidden;
}
.meter-fill {
  height: 100%; width: 0%;
  background: linear-gradient(90deg, var(--accent), var(--purple));
  border-radius: 2px;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.thread-scroll {
  flex: 1; overflow-y: auto; min-height: 0;
  margin: 0 -4px; padding: 0 4px;
  scrollbar-width: thin;
}
.thread-scroll::-webkit-scrollbar { width: 6px; }
.thread-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.thread-group { margin-bottom: 14px; }
.group-label {
  font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase;
  color: var(--text-lo); padding: 4px 10px 6px; font-weight: 600;
  display: flex; align-items: center; gap: 6px;
}
.group-label i { font-size: 9px; opacity: 0.7; }

.history-item {
  padding: 8px 10px; border-radius: var(--r-sm);
  cursor: pointer; font-size: 12.5px; color: var(--text-mid);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  border: 1px solid transparent;
  transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
}
.history-item:hover { background: var(--bg-hover); color: var(--text-hi); }
.history-item.active {
  background: var(--bg-panel-2); color: var(--text-hi);
  border-color: var(--border);
}

.sidebar-footer {
  padding-top: 12px; margin-top: 8px;
  border-top: 1px solid var(--border-soft);
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px; color: var(--text-mid);
}
.sidebar-footer .avatar {
  width: 30px; height: 30px; border-radius: 8px;
  background: linear-gradient(135deg, var(--purple), var(--accent));
  display: grid; place-items: center;
  color: white; font-size: 12px;
  flex-shrink: 0;
}

/* ============================================================================
   MAIN WORKSPACE
   ============================================================================ */
.workspace {
  display: flex; flex-direction: column;
  min-width: 0; min-height: 0;
  position: relative;
}

.topbar {
  height: 60px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 22px;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(8, 10, 15, 0.78);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  z-index: 10;
}
.topbar-left { display: flex; align-items: center; gap: 14px; min-width: 0; }
.menu-toggle {
  display: none; background: transparent; border: none;
  color: var(--text-hi); font-size: 18px; cursor: pointer; padding: 6px;
}
.ws-icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: var(--bg-panel-2); border: 1px solid var(--border);
  display: grid; place-items: center;
  color: var(--accent); font-size: 13px; flex-shrink: 0;
}
.ws-meta { min-width: 0; }
.ws-title {
  font-size: 13.5px; font-weight: 650;
  display: flex; align-items: center; gap: 8px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ws-pill {
  font-size: 9.5px; font-weight: 700; padding: 2px 7px;
  border-radius: 999px; letter-spacing: 0.4px;
  background: rgba(74, 222, 128, 0.1);
  color: var(--ok);
  border: 1px solid rgba(74, 222, 128, 0.25);
  display: inline-flex; align-items: center; gap: 5px;
  flex-shrink: 0;
}
.ws-pill::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%;
  background: var(--ok); box-shadow: 0 0 6px var(--ok);
}
.ws-pill.offline {
  background: rgba(255,92,124,0.1);
  color: var(--danger);
  border-color: rgba(255,92,124,0.25);
}
.ws-pill.offline::before {
  background: var(--danger);
  box-shadow: 0 0 6px var(--danger);
}
.ws-sub { font-size: 11px; color: var(--text-lo); margin-top: 1px; }

.topbar-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.icon-btn {
  width: 34px; height: 34px; display: grid; place-items: center;
  background: transparent; border: 1px solid transparent;
  border-radius: var(--r-sm); color: var(--text-mid);
  cursor: pointer; font-size: 14px;
  transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
}
.icon-btn:hover {
  background: var(--bg-panel); color: var(--text-hi);
  border-color: var(--border);
}

.action-btn {
  display: flex; align-items: center; gap: 7px;
  padding: 8px 12px;
  background: var(--bg-panel); border: 1px solid var(--border);
  border-radius: var(--r-sm); color: var(--text-hi);
  font-size: 12.5px; cursor: pointer;
  transition: background 0.12s ease, border-color 0.12s ease;
}
.action-btn:hover { background: var(--bg-panel-2); border-color: var(--border-hi); }
.action-btn i { color: var(--accent); }

/* ============================================================================
   CAPABILITY TABS
   ============================================================================ */
.cap-tabs {
  display: flex; gap: 4px;
  padding: 10px 22px 0;
  background: var(--bg-root);
  border-bottom: 1px solid var(--border-soft);
  flex-shrink: 0;
  overflow-x: auto;
}
.cap-tabs::-webkit-scrollbar { height: 0; }
.cap-tab {
  display: flex; align-items: center; gap: 7px;
  padding: 9px 14px;
  background: transparent;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: var(--r-sm) var(--r-sm) 0 0;
  color: var(--text-mid);
  font-size: 12.5px; font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  position: relative; top: 1px;
}
.cap-tab:hover { color: var(--text-hi); background: var(--bg-panel); }
.cap-tab.active {
  background: var(--bg-panel);
  color: var(--text-hi);
  border-color: var(--border);
  border-bottom-color: var(--bg-panel);
}
.cap-tab i { font-size: 12px; }
.cap-tab.active i { color: var(--accent); }

.cap-banner {
  padding: 10px 22px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border-soft);
  font-size: 12px;
  color: var(--text-mid);
  display: flex; align-items: center; gap: 8px;
  flex-shrink: 0;
  line-height: 1.5;
}
.cap-banner i { color: var(--accent); font-size: 13px; flex-shrink: 0; }
.cap-banner strong { color: var(--text-hi); font-weight: 600; }
.cap-banner code {
  font-family: var(--mono);
  font-size: 10.5px;
  background: rgba(16,163,127,0.08);
  color: var(--accent);
  padding: 1px 5px;
  border-radius: 3px;
}

/* ============================================================================
   CHAT STREAM
   ============================================================================ */
.chat-scroll {
  flex: 1; overflow-y: auto;
  padding: 20px 0 12px;
  scroll-behavior: smooth;
}
.chat-scroll::-webkit-scrollbar { width: 8px; }
.chat-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

.chat-inner {
  max-width: 840px; margin: 0 auto;
  padding: 0 24px;
  display: flex; flex-direction: column;
  gap: 4px;
}

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 12px;
  text-align: center; padding: 70px 20px;
  color: var(--text-mid);
  animation: fade-in 0.5s ease;
}
.empty-icon {
  width: 64px; height: 64px; border-radius: 18px;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: grid; place-items: center;
  font-size: 28px; color: white;
  box-shadow: 0 0 44px var(--accent-glow), 0 0 44px var(--purple-glow);
  margin-bottom: 8px;
}
.empty-title {
  font-size: 24px; font-weight: 800;
  color: var(--text-hi); letter-spacing: -0.3px;
}
.empty-sub {
  font-size: 13.5px; max-width: 460px;
  line-height: 1.7; color: var(--text-lo);
}

.msg-row {
  display: flex; justify-content: center;
  padding: 18px 0;
  animation: msg-lift 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes msg-lift {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.msg-row.user      { background: var(--bg-msg-user); }
.msg-row.assistant { background: var(--bg-msg-ai); }

.msg-content {
  width: 100%; max-width: 100%;
  display: flex; gap: 16px;
  align-items: flex-start;
}
.msg-avatar {
  width: 30px; height: 30px; border-radius: 6px;
  display: grid; place-items: center;
  font-size: 13px; flex-shrink: 0; color: white;
  margin-top: 2px;
}
.msg-row.user      .msg-avatar { background: var(--purple); }
.msg-row.assistant .msg-avatar { background: var(--accent); }

.msg-body { flex: 1; min-width: 0; position: relative; }
.msg-name {
  font-size: 11.5px; font-weight: 700; letter-spacing: 0.4px;
  text-transform: uppercase; color: var(--text-lo);
  margin-bottom: 6px;
}

/* Markdown-rendered content styles */
.msg-text {
  font-size: 15px; line-height: 1.7;
  color: var(--text-hi);
  word-break: break-word;
}
.msg-text p { margin: 0 0 10px 0; }
.msg-text p:last-child { margin-bottom: 0; }
.msg-text h1, .msg-text h2, .msg-text h3, .msg-text h4 {
  margin: 16px 0 8px 0; font-weight: 700; line-height: 1.3;
}
.msg-text h1 { font-size: 1.4em; }
.msg-text h2 { font-size: 1.25em; }
.msg-text h3 { font-size: 1.1em; }
.msg-text ul, .msg-text ol { margin: 8px 0 12px 20px; }
.msg-text li { margin-bottom: 4px; }
.msg-text strong { color: #fff; font-weight: 700; }
.msg-text em { font-style: italic; }
.msg-text a { color: var(--accent); text-decoration: underline; }
.msg-text blockquote {
  border-left: 3px solid var(--accent);
  padding-left: 12px;
  margin: 12px 0;
  color: var(--text-mid);
}
.msg-text code {
  font-family: var(--mono);
  font-size: 0.9em;
  background: rgba(255,255,255,0.06);
  padding: 2px 6px;
  border-radius: 4px;
  color: #e2e8f0;
}
.msg-text pre {
  background: #0a0d13;
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 14px 16px;
  margin: 12px 0;
  overflow-x: auto;
  position: relative;
}
.msg-text pre code {
  background: none;
  padding: 0;
  font-size: 12.5px;
  line-height: 1.6;
  color: #b8c4d8;
}

/* Copy button inside markdown code blocks */
.copy-wrap { position: relative; }
.copy-wrap pre { padding-right: 44px; }
.copy-btn {
  position: absolute; top: 8px; right: 8px;
  width: 30px; height: 30px;
  display: grid; place-items: center;
  background: var(--bg-panel-2);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  color: var(--text-mid); font-size: 11px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.copy-btn:hover { background: var(--bg-hover); color: var(--accent); }
.copy-btn.copied { color: var(--ok); border-color: rgba(74,222,128,0.4); }

.caret {
  display: inline-block; width: 7px; height: 15px;
  background: var(--accent); border-radius: 1px;
  vertical-align: -2px; margin-left: 2px;
  animation: blink 1s steps(2, start) infinite;
}
@keyframes blink {
  0%, 50%  { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.typing-dots {
  display: inline-flex; gap: 4px; align-items: center;
  padding: 4px 0;
}
.typing-dots span {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--text-lo);
  animation: dot-bounce 1.2s infinite ease-in-out;
}
.typing-dots span:nth-child(2) { animation-delay: 0.15s; }
.typing-dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes dot-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40%           { transform: translateY(-4px); opacity: 1; }
}

@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

/* ============================================================================
   FLOATING PILL COMPOSER
   ============================================================================ */
.composer-wrap {
  flex-shrink: 0;
  padding: 16px 24px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, transparent, rgba(8,10,15,0.94) 40%);
  position: relative;
  z-index: 5;
}

.composer-pill {
  width: 100%;
  max-width: 840px;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  padding: 10px 10px 10px 12px;
  background: var(--pill-bg);
  border: 1px solid var(--pill-border);
  border-radius: var(--pill-radius);
  box-shadow: var(--pill-shadow);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, border-radius 0.2s ease;
}

.composer-pill.focused {
  border-color: rgba(16,163,127,0.45);
  box-shadow: var(--pill-shadow-focus);
}

.composer-pill.expanded {
  border-radius: var(--pill-radius-expanded);
}

.attach-btn {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 50%;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-mid);
  font-size: 15px;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  margin-bottom: 2px;
}
.attach-btn:hover {
  background: rgba(255,255,255,0.06);
  color: var(--text-hi);
  border-color: rgba(255,255,255,0.08);
}
.attach-btn:active { transform: scale(0.94); }

.chat-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-hi);
  font-family: inherit;
  font-size: 15px;
  line-height: 1.55;
  padding: 8px 4px;
  resize: none;
  min-height: 22px;
  max-height: 200px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
.chat-input::-webkit-scrollbar { width: 5px; }
.chat-input::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
.chat-input::placeholder { color: var(--text-lo); }

.send-btn {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  font-size: 14px;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(16,163,127,0.4), inset 0 0 0 1px rgba(255,255,255,0.1);
  transition: transform 0.12s ease, box-shadow 0.15s ease, opacity 0.2s ease, filter 0.15s ease;
  margin-bottom: 2px;
}
.send-btn:hover:not(:disabled) {
  transform: scale(1.06);
  box-shadow: 0 6px 20px rgba(16,163,127,0.6), inset 0 0 0 1px rgba(255,255,255,0.15);
  filter: brightness(1.05);
}
.send-btn:active:not(:disabled) { transform: scale(0.94); }
.send-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  box-shadow: none;
  background: #3a3f4a;
}

.composer-hint {
  max-width: 840px;
  margin: 10px auto 0;
  text-align: center;
  font-size: 10.5px;
  color: var(--text-lo);
  letter-spacing: 0.2px;
  padding: 0 24px;
}
.composer-hint.error { color: var(--danger); }

/* ============================================================================
   MODAL
   ============================================================================ */
.modal-backdrop {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(4px);
  z-index: 100;
  align-items: center; justify-content: center;
  padding: 20px;
}
.modal-backdrop.show { display: flex; animation: fade-in 0.2s ease; }

.modal {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  width: 100%; max-width: 460px;
  padding: 24px;
  box-shadow: var(--shadow-3);
  animation: modal-pop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes modal-pop {
  from { opacity: 0; transform: scale(0.94) translateY(8px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20px;
}
.modal-head h2 { font-size: 16px; font-weight: 700; }
.modal-head button {
  background: transparent; border: none; color: var(--text-mid);
  font-size: 16px; cursor: pointer; padding: 4px;
}
.modal-head button:hover { color: var(--text-hi); }

.form-group { margin-bottom: 16px; }
.form-group label {
  display: block; font-size: 11.5px; font-weight: 600;
  color: var(--text-mid); text-transform: uppercase;
  letter-spacing: 0.5px; margin-bottom: 7px;
}
.form-group input,
.form-group select {
  width: 100%;
  background: var(--bg-root);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  padding: 10px 12px;
  color: var(--text-hi);
  font-family: inherit; font-size: 13px;
  outline: none;
  transition: border-color 0.15s ease;
}
.form-group input { font-family: var(--mono); }
.form-group input:focus,
.form-group select:focus { border-color: var(--accent); }

.form-hint {
  font-size: 10.5px; color: var(--text-lo);
  margin-top: 6px; line-height: 1.55;
}
.form-hint code {
  font-family: var(--mono); font-size: 10px;
  color: var(--accent);
  background: rgba(16,163,127,0.08);
  padding: 1px 4px; border-radius: 3px;
}

.modal-actions {
  display: flex; gap: 10px;
  justify-content: flex-end; margin-top: 6px;
}
.btn {
  padding: 10px 18px;
  border-radius: var(--r-sm);
  font-size: 12.5px; font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
}
.btn-ghost {
  background: transparent; border-color: var(--border);
  color: var(--text-mid);
}
.btn-ghost:hover { background: var(--bg-panel-2); color: var(--text-hi); }
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  box-shadow: 0 4px 14px rgba(16,163,127,0.35);
}
.btn-primary:hover { filter: brightness(1.08); }

/* ============================================================================
   MOBILE RESPONSIVE
   ============================================================================ */
.sidebar-backdrop {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.65);
  z-index: 15;
  backdrop-filter: blur(2px);
}

@media (max-width: 900px) {
  .app-shell { grid-template-columns: 1fr; }

  .sidebar {
    position: fixed; top: 0; left: 0; bottom: 0;
    width: 300px;
    transform: translateX(-100%);
    box-shadow: var(--shadow-3);
    z-index: 20;
  }
  .sidebar.open { transform: translateX(0); }
  .sidebar.open ~ .sidebar-backdrop { display: block; }

  .menu-toggle { display: block; }
  .topbar { padding: 0 14px; }
  .chat-inner { padding: 0 14px; }
  .composer-wrap { padding: 12px 14px 18px; }
  .cap-tabs { padding: 8px 14px 0; }
  .cap-banner { padding: 8px 14px; font-size: 11px; }
  .action-btn span { display: none; }
  .action-btn { padding: 8px 10px; }
  .msg-content { gap: 12px; }
  .empty-state { padding: 50px 20px; }
  .empty-title { font-size: 20px; }
  .empty-sub { font-size: 12.5px; }
}

@media (max-width: 480px) {
  .ws-sub { display: none; }
  .action-btn { padding: 8px; }
  .icon-btn { width: 30px; height: 30px; }
  .cap-tab span { display: none; }
  .cap-tab { padding: 10px 12px; }
  .cap-banner code { display: none; }
  .composer-pill { padding: 8px 8px 8px 8px; gap: 6px; }
  .attach-btn, .send-btn { width: 34px; height: 34px; }
  .chat-input { font-size: 14.5px; padding: 7px 4px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>
<body>

<div class="app-shell">

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-bolt"></i></div>
      <div class="brand-text">
        <div class="brand-name">ApexGPT</div>
        <div class="brand-sub">Peak Multimodal Studio</div>
      </div>
    </div>

    <button class="new-chat-btn" onclick="startNewSession()">
      <i class="fa-solid fa-plus"></i> New Session
