          <div class="ws-sub" id="workspaceSub">ApexGPT · Groq production models</div>
        </div>
      </div>
      <div class="topbar-actions">
        <button class="icon-btn" onclick="toggleModal(true)" title="API Settings">
          <i class="fa-solid fa-gear"></i>
        </button>
        <button class="action-btn" onclick="downloadSourceFile()" title="Download standalone HTML">
          <i class="fa-solid fa-download"></i> <span>Export</span>
        </button>
      </div>
    </header>

    <div class="cap-tabs" id="capTabs">
      <button class="cap-tab active" data-cap="reasoning" onclick="switchCapability('reasoning')">
        <i class="fa-solid fa-brain"></i> <span>Text &amp; Deep Reasoning</span>
      </button>
      <button class="cap-tab" data-cap="media" onclick="switchCapability('media')">
        <i class="fa-solid fa-photo-film"></i> <span>Multimodal Media</span>
      </button>
      <button class="cap-tab" data-cap="agent" onclick="switchCapability('agent')">
        <i class="fa-solid fa-terminal"></i> <span>Agent Code Runner</span>
      </button>
    </div>

    <div class="cap-banner" id="capBanner">
      <i class="fa-solid fa-brain"></i>
      <span id="capBannerText"><strong>Deep Reasoning Workspace</strong> — Ask for analysis, planning, code review, or structured writing. Streams token-by-token from <code>openai/gpt-oss-120b</code>.</span>
    </div>

    <div class="chat-scroll" id="chatContainer">
      <div class="chat-inner" id="chatInner"></div>
    </div>

    <div class="composer-wrap">
      <div class="composer-pill" id="composerPill">
        <button class="attach-btn" id="attachBtn" title="Attach document" aria-label="Attach document">
          <i class="fa-solid fa-paperclip"></i>
        </button>
        <textarea
          class="chat-input"
          id="chatInput"
          rows="1"
          placeholder="Ask anything — reasoning, media prompts, or agent tasks..."
          onkeydown="handleKeyPress(event)"
          oninput="autoResize()"></textarea>
        <button class="send-btn" id="sendBtn" onclick="sendMessage()" disabled aria-label="Send message">
          <i class="fa-solid fa-arrow-up"></i>
        </button>
      </div>
      <div class="composer-hint" id="composerHint">
        Enter to send · Shift + Enter for newline
      </div>
