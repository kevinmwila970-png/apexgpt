    <div class="telemetry" id="telemetry">
      <div class="telemetry-title">
        <span class="pulse-dot"></span> Live Telemetry
      </div>

      <div class="meter">
        <div class="meter-head">
          <span class="meter-label">Latency</span>
          <span class="meter-value" id="metricLatency">—</span>
        </div>
        <div class="meter-bar"><div class="meter-fill" id="barLatency"></div></div>
      </div>

      <div class="meter">
        <div class="meter-head">
          <span class="meter-label">Speed (TPS)</span>
          <span class="meter-value" id="metricTps">0</span>
        </div>
        <div class="meter-bar"><div class="meter-fill" id="barTps"></div></div>
      </div>

      <div class="meter">
        <div class="meter-head">
          <span class="meter-label">Session Tokens</span>
          <span class="meter-value" id="metricTokens">0</span>
        </div>
        <div class="meter-bar"><div class="meter-fill" id="barTokens"></div></div>
