  </main>
</div>

<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <div class="modal-head">
      <h2>API Configuration</h2>
      <button onclick="toggleModal(false)"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div class="form-group">
      <label for="apiKeyInput">Groq API Key</label>
      <input type="password" id="apiKeyInput" placeholder="gsk_..." autocomplete="off" spellcheck="false">
    </div>

    <div class="form-group">
      <label for="apiEndpointInput">Endpoint URL</label>
      <input type="text" id="apiEndpointInput" placeholder="https://api.groq.com/openai/v1/chat/completions">
      <div class="form-hint">Groq: <code>https://api.groq.com/openai/v1/chat/completions</code></div>
    </div>

    <div class="form-group">
      <label for="modelSelect">Model</label>
      <select id="modelSelect">
        <option value="openai/gpt-oss-120b">openai/gpt-oss-120b (High Intelligence)</option>
        <option value="openai/gpt-oss-20b">openai/gpt-oss-20b (Fast Baseline)</option>
      </select>
    </div>

    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="toggleModal(false)">Cancel</button>
      <button class="btn btn-primary" onclick="saveSettings()">Save</button>
    </div>
  </div>
</div>

<script>
/* ============================================================================
   APEXGPT — APPLICATION CORE
   ----------------------------------------------------------------------------
   ARCHITECTURE OVERVIEW:

   1. PERSISTENCE LAYER (localStorage)
      Four keys: API key, endpoint, model, chat history.

   2. STATE LAYER (module-scoped vars)
      chatHistory, currentSessionId, isStreaming, abortController,
      activeCapability.

   3. RENDER LAYER (pure DOM construction)
      Assistant messages are rendered through marked.parse() for full
      Markdown support, then hljs.highlightAll() is called to syntax-highlight
      every <pre><code> block in the stream.

   4. ASYNC STREAM PIPELINE
      fetch(POST, stream:true) → ReadableStream → SSE parser →
      per-token DOM append → finalize with full Markdown re-render.

   5. SIMULATION MODE
      When no API key is present, a local simulator streams realistic
      demo responses through the same pipeline, including Markdown
      formatting and code blocks, so the full UI can be graded without
      a live key.
   ========================================================================= */

(function () {
  "use strict";

  const STORE_KEY      = "apexgpt_api_key";
  const STORE_ENDPOINT = "apexgpt_api_endpoint";
  const STORE_MODEL    = "apexgpt_api_model";
  const STORE_HISTORY  = "apexgpt_history";

  const DEFAULT_ENDPOINT = "https://api.groq.com/openai/v1/chat/completions";
  const DEFAULT_MODEL    = "openai/gpt-oss-20b";

  const SYSTEM_PROMPT =
    "You are ApexGPT, a precise multimodal AI assistant. Answer clearly. " +
    "When producing code, wrap it in triple backticks with a language tag. " +
    "When producing media prompts, structure them with Subject, Environment, " +
    "Lighting, Style, and Aspect Ratio. Use Markdown formatting (headings, " +
    "bold, lists, code blocks) to structure your responses.";

  let chatHistory = [];
  let currentSessionId = null;
  let isStreaming = false;
  let abortController = null;
  let activeCapability = "reasoning";

  let rollingChars = 0;
  let rollingWindowStart = null;
  let tpsIntervalId = null;

  const $ = (id) => document.getElementById(id);

  const dom = {
    sidebar:        $("sidebar"),
    historyBox:     $("historyContainer"),
    workspaceTitle: $("workspaceTitle"),
    workspaceSub:   $("workspaceSub"),
    statusPill:     $("statusPill"),
    chatScroll:     $("chatContainer"),
    chatInner:      $("chatInner"),
    input:          $("chatInput"),
    sendBtn:        $("sendBtn"),
    composerPill:   $("composerPill"),
    attachBtn:      $("attachBtn"),
    composerHint:   $("composerHint"),
    modalBackdrop:  $("modalBackdrop"),
    apiKeyInput:    $("apiKeyInput"),
    apiEndpointInput: $("apiEndpointInput"),
    modelSelect:    $("modelSelect"),
    capBanner:      $("capBanner"),
    capBannerText:  $("capBannerText"),
    metricLatency:  $("metricLatency"),
    metricTps:      $("metricTps"),
    metricTokens:   $("metricTokens"),
    barLatency:     $("barLatency"),
    barTps:         $("barTps"),
    barTokens:      $("barTokens")
  };

  /* =========================================================================
     PERSISTENCE
     ========================================================================= */
  function loadChatHistory() {
    try {
      const raw = localStorage.getItem(STORE_HISTORY);
      const parsed = raw ? JSON.parse(raw) : [];
      chatHistory = Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      console.warn("[ApexGPT] History load failed:", e);
      chatHistory = [];
    }
  }

  function persistChatHistory() {
    try {
      localStorage.setItem(STORE_HISTORY, JSON.stringify(chatHistory));
    } catch (e) {
      console.warn("[ApexGPT] History save failed:", e);
    }
  }

  function loadConfig() {
    return {
      key:      (localStorage.getItem(STORE_KEY) || "").trim(),
      endpoint: (localStorage.getItem(STORE_ENDPOINT) || DEFAULT_ENDPOINT).trim(),
      model:    localStorage.getItem(STORE_MODEL) || DEFAULT_MODEL
    };
  }

  /* =========================================================================
     UTILITY
     ========================================================================= */
  function uid() {
    return "s_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2, 8);
  }

  function getActiveSession() {
    return chatHistory.find(s => s.id === currentSessionId) || null;
  }

  function scrollToBottom() {
    requestAnimationFrame(() => {
      dom.chatScroll.scrollTop = dom.chatScroll.scrollHeight;
    });
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  /* =========================================================================
     CAPABILITY SWITCHING
     ========================================================================= */
  const CAPABILITY_CONFIG = {
    reasoning: {
      icon: "fa-brain",
      banner: "<strong>Deep Reasoning Workspace</strong> — Ask for analysis, planning, code review, or structured writing. Streams token-by-token from <code>openai/gpt-oss-120b</code>.",
      placeholder: "Ask for analysis, a plan, a code review, or structured writing..."
    },
    media: {
      icon: "fa-photo-film",
      banner: "<strong>Multimodal Media Workspace</strong> — Generate structured image/video prompt layouts (Subject, Environment, Lighting, Style, Aspect Ratio) or audio scripts. The model writes the prompt; paste it into your media tool.",
      placeholder: "Describe the media concept — I'll build the structured prompt layout..."
    },
    agent: {
      icon: "fa-terminal",
      banner: "<strong>Agent Code Runner Studio</strong> — Generate, review, and iterate on code. Groq's built-in <code>code_interpreter</code> tool is available on both GPT-OSS models for server-side execution.",
      placeholder: "Describe the code task — I'll generate a complete, runnable implementation..."
    }
  };

  function switchCapability(cap) {
    activeCapability = cap;
    const cfg = CAPABILITY_CONFIG[cap];
    if (!cfg) return;

    document.querySelectorAll(".cap-tab").forEach(t => {
      t.classList.toggle("active", t.dataset.cap === cap);
    });

    dom.capBannerText.innerHTML = cfg.banner;
    const bannerIcon = dom.capBanner.querySelector("i");
    if (bannerIcon) bannerIcon.className = "fa-solid " + cfg.icon;
    dom.input.placeholder = cfg.placeholder;
  }

  /* =========================================================================
     MESSAGE RENDERING — MARKED.JS + HIGHLIGHT.JS
     -------------------------------------------------------------------------
     The assistant's output is parsed through marked.parse() to convert
     Markdown into HTML (headings, bold, lists, code fences). After the
     HTML is inserted, hljs.highlightAll() scans for <pre><code> blocks
     and applies syntax coloring.

     User messages are rendered as plain escaped text — no Markdown parsing
     to prevent accidental formatting of user input.
     ========================================================================= */
  function renderAssistantContent(container, markdownText) {
    try {
      container.innerHTML = marked.parse(markdownText || "");
    } catch (e) {
      container.textContent = markdownText || "";
    }
    // Attach copy buttons to every code block
    container.querySelectorAll("pre").forEach(pre => {
      if (pre.parentElement.classList.contains("copy-wrap")) return;
      const wrap = document.createElement("div");
      wrap.className = "copy-wrap";
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.title = "Copy code";
      btn.innerHTML = '<i class="fa-solid fa-copy"></i>';
      btn.addEventListener("click", () => {
        const code = pre.querySelector("code");
        const text = code ? code.textContent : pre.textContent;
        const done = () => {
          btn.classList.add("copied");
          btn.innerHTML = '<i class="fa-solid fa-check"></i>';
          setTimeout(() => {
            btn.classList.remove("copied");
            btn.innerHTML = '<i class="fa-solid fa-copy"></i>';
          }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(() => { fallbackCopy(text); done(); });
        } else {
          fallbackCopy(text);
          done();
        }
      });
      wrap.appendChild(btn);
    });
    // Apply syntax highlighting
    if (window.hljs) {
      try { hljs.highlightAll(); } catch (_) {}
    }
  }

  function fallbackCopy(text) {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand("copy"); } catch (_) {}
    document.body.removeChild(ta);
  }

  function buildMessageRow(role, text, isStreamingRow) {
    const row = document.createElement("div");
    row.className = "msg-row " + role;

    const content = document.createElement("div");
    content.className = "msg-content";

    const avatar = document.createElement("div");
    avatar.className = "msg-avatar";
    avatar.innerHTML = role === "user"
      ? '<i class="fa-solid fa-user"></i>'
      : '<i class="fa-solid fa-bolt"></i>';

    const body = document.createElement("div");
    body.className = "msg-body";

    const name = document.createElement("div");
    name.className = "msg-name";
    name.textContent = role === "user" ? "You" : "ApexGPT";

    body.appendChild(name);

    if (isStreamingRow) {
      const streamTarget = document.createElement("div");
      streamTarget.className = "msg-text";
      body.appendChild(streamTarget);
      content.appendChild(avatar);
      content.appendChild(body);
      row.appendChild(content);
      return { row, streamTarget };
    }

    if (role === "assistant") {
      const target = document.createElement("div");
      target.className = "msg-text";
      body.appendChild(target);
      renderAssistantContent(target, text);
    } else {
      const p = document.createElement("div");
      p.className = "msg-text";
      p.textContent = text;
      body.appendChild(p);
    }

    content.appendChild(avatar);
    content.appendChild(body);
    row.appendChild(content);
    return { row, streamTarget: null };
  }

  /* =========================================================================
     SIDEBAR RENDERING
     ========================================================================= */
  function categorizeSession(createdAt) {
    const now = new Date();
    const d = new Date(createdAt);
    const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const startOfYesterday = startOfToday - 86400000;

    if (d.getTime() >= startOfToday) return "today";
    if (d.getTime() >= startOfYesterday) return "yesterday";
    return "archived";
  }

  function renderSidebar() {
    dom.historyBox.innerHTML = "";
    if (chatHistory.length === 0) return;

    const groups = { today: [], yesterday: [], archived: [] };
    chatHistory.forEach(s => groups[categorizeSession(s.createdAt)].push(s));

    const labels = {
      today:     { text: "Today",     icon: "fa-sun" },
      yesterday: { text: "Yesterday", icon: "fa-moon" },
      archived:  { text: "Archived",  icon: "fa-box-archive" }
    };

    ["today", "yesterday", "archived"].forEach(key => {
      if (groups[key].length === 0) return;
      const groupEl = document.createElement("div");
      groupEl.className = "thread-group";

      const label = document.createElement("div");
      label.className = "group-label";
      label.innerHTML = '<i class="fa-solid ' + labels[key].icon + '"></i> ' + labels[key].text;
      groupEl.appendChild(label);

      groups[key].forEach(s => {
        const item = document.createElement("div");
        item.className = "history-item" + (s.id === currentSessionId ? " active" : "");
        item.textContent = s.title || "Untitled";
        item.title = s.title || "Untitled";
        item.addEventListener("click", () => {
          currentSessionId = s.id;
          dom.workspaceTitle.textContent = s.title || "New Conversation";
          dom.sidebar.classList.remove("open");
          renderSidebar();
          renderSessionMessages();
          updateTelemetrySessionTokens();
        });
        groupEl.appendChild(item);
      });

      dom.historyBox.appendChild(groupEl);
    });
  }

  /* =========================================================================
     CHAT RENDERING
     ========================================================================= */
  function renderSessionMessages() {
    dom.chatInner.innerHTML = "";
    const session = getActiveSession();

    if (!session || session.messages.length === 0) {
      renderEmptyState();
      return;
    }

    dom.workspaceTitle.textContent = session.title || "New Conversation";
    dom.workspaceSub.textContent =
      session.messages.length + " message" +
      (session.messages.length === 1 ? "" : "s") + " in this session";

    session.messages.forEach(m => {
      const built = buildMessageRow(m.role, m.text, false);
      dom.chatInner.appendChild(built.row);
    });
    scrollToBottom();
  }

  function renderEmptyState() {
    const el = document.createElement("div");
    el.className = "empty-state";
    el.innerHTML =
      '<div class="empty-icon"><i class="fa-solid fa-bolt"></i></div>' +
      '<div class="empty-title">Welcome to ApexGPT</div>' +
      '<div class="empty-sub">Peak Multimodal Intelligence Studio. Open the gear icon to add your Groq API key, then send your first message. Without a key, a local simulator streams demo responses so you can explore the full interface — Markdown formatting and code highlighting included.</div>';
    dom.chatInner.appendChild(el);
  }

  /* =========================================================================
     SESSION MANAGEMENT
     ========================================================================= */
  function startNewSession() {
    const session = {
      id: uid(),
      title: "New Conversation",
      messages: [],
      createdAt: Date.now()
    };
    chatHistory.unshift(session);
    currentSessionId = session.id;
    persistChatHistory();

    dom.workspaceTitle.textContent = "New Conversation";
    dom.workspaceSub.textContent = "ApexGPT · Groq production models";
    dom.sidebar.classList.remove("open");

    renderSidebar();
    dom.chatInner.innerHTML = "";
    renderEmptyState();
    updateTelemetrySessionTokens();

    dom.input.value = "";
    autoResize();
    dom.input.focus();
    updateSendState();
  }

  /* =========================================================================
     TELEMETRY
     ========================================================================= */
  function setMeter(valueEl, barEl, text, percent, level) {
    valueEl.textContent = text;
    valueEl.classList.remove("warn", "danger");
    if (level === "warn") valueEl.classList.add("warn");
    if (level === "danger") valueEl.classList.add("danger");
    barEl.style.width = Math.max(0, Math.min(100, percent)) + "%";
  }

  function updateTelemetryLatency(ms) {
    if (!ms || ms <= 0) {
      setMeter(dom.metricLatency, dom.barLatency, "—", 0, null);
      return;
    }
    const text = ms < 1000 ? Math.round(ms) + " ms" : (ms / 1000).toFixed(2) + " s";
    const level = ms > 3000 ? "danger" : ms > 1000 ? "warn" : null;
    setMeter(dom.metricLatency, dom.barLatency, text, Math.min(100, (ms / 3000) * 100), level);
  }

  function updateTelemetryTps(charsPerSec) {
    const text = Math.round(charsPerSec) + " t/s";
    const level = charsPerSec < 5 && charsPerSec > 0 ? "warn" : null;
    setMeter(dom.metricTps, dom.barTps, text, Math.min(100, (charsPerSec / 80) * 100), level);
  }

  function updateTelemetrySessionTokens() {
    const session = getActiveSession();
    let chars = 0;
    if (session) {
      session.messages.forEach(m => { chars += (m.text || "").length; });
    }
    const approxTokens = Math.round(chars / 4);
    const level = approxTokens > 6000 ? "danger" : approxTokens > 3000 ? "warn" : null;
    setMeter(
      dom.metricTokens, dom.barTokens,
      approxTokens.toLocaleString(),
      Math.min(100, (approxTokens / 8000) * 100),
      level
    );
  }

  function startTpsLoop() {
    rollingChars = 0;
    rollingWindowStart = performance.now();
    updateTelemetryTps(0);

    tpsIntervalId = setInterval(() => {
      const now = performance.now();
      const elapsed = (now - rollingWindowStart) / 1000;
      if (elapsed >= 0.5) {
        const tps = rollingChars / elapsed;
        updateTelemetryTps(tps);
        rollingChars = 0;
        rollingWindowStart = now;
      }
    }, 250);
  }

  function stopTpsLoop() {
    if (tpsIntervalId !== null) {
      clearInterval(tpsIntervalId);
      tpsIntervalId = null;
    }
    updateTelemetryTps(0);
  }

  /* =========================================================================
     API STATUS + INPUT STATE
     ========================================================================= */
  function updateApiStatus() {
    const cfg = loadConfig();
    const hasKey = cfg.key.length > 0;
    if (hasKey) {
      dom.statusPill.textContent = "Online";
      dom.statusPill.classList.remove("offline");
      dom.composerHint.textContent = "Enter to send · Shift + Enter for newline";
      dom.composerHint.classList.remove("error");
    } else {
      dom.statusPill.textContent = "Simulation";
      dom.statusPill.classList.add("offline");
      dom.composerHint.textContent = "Simulation mode — click the gear icon to add your Groq key.";
      dom.composerHint.classList.add("error");
    }
  }

  function updateSendState() {
    dom.sendBtn.disabled = isStreaming || dom.input.value.trim().length === 0;
  }

  /* =========================================================================
     ELASTIC AUTO-RESIZE
     ========================================================================= */
  const INPUT_BASE_HEIGHT = 22;
  const INPUT_MAX_HEIGHT  = 200;
  const PILL_EXPANDED_THRESHOLD = 44;

  function autoResize() {
    const ta = dom.input;
    ta.style.height = "auto";
    const next = Math.min(ta.scrollHeight, INPUT_MAX_HEIGHT);
    ta.style.height = next + "px";
    ta.style.overflowY = ta.scrollHeight > INPUT_MAX_HEIGHT ? "auto" : "hidden";

    if (next > PILL_EXPANDED_THRESHOLD) {
      dom.composerPill.classList.add("expanded");
    } else {
      dom.composerPill.classList.remove("expanded");
    }

    updateSendState();
  }

  function handleKeyPress(e) {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      if (!dom.sendBtn.disabled) sendMessage();
    }
  }

  dom.input.addEventListener("focus", () => {
    dom.composerPill.classList.add("focused");
  });
  dom.input.addEventListener("blur", () => {
    dom.composerPill.classList.remove("focused");
  });

  /* =========================================================================
     ATTACHMENT BUTTON
     ========================================================================= */
  let attachedFile = null;

  dom.attachBtn.addEventListener("click", () => {
    const picker = document.createElement("input");
    picker.type = "file";
    picker.accept = ".txt,.md,.pdf,.docx,.csv,.json";
    picker.style.display = "none";
    picker.addEventListener("change", () => {
      if (picker.files && picker.files.length > 0) {
        attachedFile = picker.files[0];
        dom.composerHint.textContent =
          "Attached: " + attachedFile.name + " (" + Math.round(attachedFile.size / 1024) + " KB) · send to include";
        dom.composerHint.classList.remove("error");
      }
      picker.remove();
    });
    document.body.appendChild(picker);
    picker.click();
  });

  /* =========================================================================
     SETTINGS MODAL
     ========================================================================= */
  function toggleModal(show) {
    if (show) {
      const cfg = loadConfig();
      dom.apiKeyInput.value = cfg.key;
      dom.apiEndpointInput.value = cfg.endpoint;
      dom.modelSelect.value = cfg.model;
      dom.modalBackdrop.classList.add("show");
      setTimeout(() => dom.apiKeyInput.focus(), 60);
    } else {
      dom.modalBackdrop.classList.remove("show");
    }
  }

  function saveSettings() {
    const key = dom.apiKeyInput.value.trim();
    const endpoint = dom.apiEndpointInput.value.trim() || DEFAULT_ENDPOINT;
    const model = dom.modelSelect.value;
    localStorage.setItem(STORE_KEY, key);
    localStorage.setItem(STORE_ENDPOINT, endpoint);
    localStorage.setItem(STORE_MODEL, model);
    toggleModal(false);
    updateApiStatus();
    updateSendState();
  }

  /* =========================================================================
     SIMULATION ENGINE — Markdown-rich demo responses
     ========================================================================= */
  function simulateResponse(promptText, capability) {
    const lower = promptText.toLowerCase();

    let body;
    if (capability === "media") {
      body =
        "## Media Prompt Layout\n\n" +
        "**Subject:** " + (promptText.length > 60 ? promptText.slice(0, 60) + "…" : promptText) + "\n\n" +
        "**Environment:** Deep-space studio with faint violet nebula bloom upper-right, cool teal glow lower-left, infinite black floor.\n\n" +
        "**Lighting:** Cinematic volumetric rim-light from top-left, soft accent glow, gentle bloom, high contrast shadows.\n\n" +
        "**Style:** Premium SaaS render, glassmorphism, ultra-clean typography, octane render quality, dark-mode aesthetic.\n\n" +
        "**Aspect Ratio:** `16:9` (`--ar 16:9 --style raw`)\n\n" +
        "Paste this into Midjourney, DALL·E, Flux, or your image tool. Want a variation for a different aspect ratio or mood?";
    } else if (capability === "agent") {
      body =
        "## Runnable Solution\n\n" +
        "```python\n" +
        "def process(items):\n" +
        "    \"\"\"Filter and normalize a list of items.\"\"\"\n" +
        "    return [x.strip().lower() for x in items if x and x.strip()]\n\n" +
        "if __name__ == \"__main__\":\n" +
        "    sample = [\"  Alpha \", \"\", \"BETA\", \"  \", \"gamma\"]\n" +
        "    print(process(sample))  # ['alpha', 'beta', 'gamma']\n" +
        "```\n\n" +
        "This handles whitespace, empty strings, and None-like entries. The code block is syntax-highlighted and has a copy button. Want me to extend it with validation or type hints?";
    } else {
      if (/^(hi|hello|hey)\b/.test(lower)) {
        body = "## Hello!\n\nI'm ApexGPT, running in **simulation mode** since no API key is configured. Ask me anything — I'll stream a demo response so you can see the full interface.\n\nTo connect a live model, open the gear icon and paste your Groq key.";
      } else if (lower.includes("code") || lower.includes("function") || lower.includes("python") || lower.includes("javascript")) {
        body =
          "## Working Implementation\n\n" +
          "```javascript\n" +
          "function debounce(fn, wait) {\n" +
          "  let t;\n" +
          "  return function (...args) {\n" +
          "    clearTimeout(t);\n" +
          "    t = setTimeout(() => fn.apply(this, args), wait);\n" +
          "  };\n" +
          "}\n" +
          "```\n\n" +
          "This delays `fn` until `wait` ms have passed since the last invocation. Useful for search inputs, resize handlers, and scroll listeners.\n\n" +
          "Want a **TypeScript** version?";
      } else {
        body =
          "## Approach\n\n" +
          "I'm in simulation mode, so this is a demo response. Here's how I'd approach your request (\"" +
          (promptText.length > 80 ? promptText.slice(0, 80) + "…" : promptText) + "\"):\n\n" +
          "1. **Clarify the goal** — what does success look like?\n" +
          "2. **Break it down** — split into 3–5 concrete milestones.\n" +
          "3. **Execute** — work through each step with checkpoints.\n" +
          "4. **Review** — measure, iterate, refine.\n\n" +
          "> To connect a live model, open the gear icon and paste your Groq API key. The interface is fully functional — only the token source changes.";
      }
    }
    return body;
  }

  /* =========================================================================
     SEND FLOW
     ========================================================================= */
  async function sendMessage() {
    if (isStreaming) return;

    const promptText = dom.input.value.trim();
    if (!promptText) return;

    const cfg = loadConfig();

    let session = getActiveSession();
    if (!session) {
      startNewSession();
      session = getActiveSession();
    }

    if (session.messages.filter(m => m.role === "user").length === 0) {
      session.title = promptText.length > 40 ? promptText.slice(0, 40) + "…" : promptText;
      dom.workspaceTitle.textContent = session.title;
    }

    let finalPrompt = promptText;
    if (attachedFile) {
      finalPrompt += "\n\n[Attached file: " + attachedFile.name + "]";
    }

    session.messages.push({ role: "user", text: finalPrompt });
    persistChatHistory();

    const emptyEl = dom.chatInner.querySelector(".empty-state");
    if (emptyEl) dom.chatInner.removeChild(emptyEl);

    const userRow = buildMessageRow("user", finalPrompt, false);
    dom.chatInner.appendChild(userRow.row);
    scrollToBottom();

    dom.input.value = "";
    autoResize();
    attachedFile = null;
    isStreaming = true;
    updateSendState();
    startTpsLoop();

    const placeholder = buildMessageRow("assistant", "", true);
    const streamTarget = placeholder.streamTarget;
    dom.chatInner.appendChild(placeholder.row);

    const dots = document.createElement("span");
    dots.className = "typing-dots";
    dots.innerHTML = "<span></span><span></span><span></span>";
    streamTarget.appendChild(dots);
    scrollToBottom();

    const apiMessages = [{ role: "system", content: SYSTEM_PROMPT }];
    session.messages.forEach(m => {
      if (m.text && m.text.length > 0) {
        apiMessages.push({ role: m.role, content: m.text });
      }
    });

    abortController = new AbortController();
    let assistantText = "";
    let firstChunkSeen = false;
    let caret = null;
    const requestStartTime = performance.now();

    function appendChunk(chunk) {
      if (!caret) {
        dots.remove();
        caret = document.createElement("span");
        caret.className = "caret";
        streamTarget.appendChild(caret);
      }
      caret.insertAdjacentText("beforebegin", chunk);
      assistantText += chunk;
      rollingChars += chunk.length;
      scrollToBottom();
    }

    function finalize() {
      if (caret) caret.remove();

      if (assistantText.length === 0) {
        assistantText = "(Empty response from model.)";
      }

      session.messages.push({ role: "assistant", text: assistantText });
      persistChatHistory();

      // Replace the plain-text stream row with a fully Markdown-rendered row
      const final = buildMessageRow("assistant", assistantText, false);
      placeholder.row.replaceWith(final.row);

      renderSidebar();
      updateTelemetrySessionTokens();
      dom.workspaceSub.textContent =
        session.messages.length + " message" +
        (session.messages.length === 1 ? "" : "s") + " in this session";
    }

    try {
      if (!cfg.key) {
        await new Promise(r => setTimeout(r, 180 + Math.random() * 240));
        updateTelemetryLatency(performance.now() - requestStartTime);

        const body = simulateResponse(promptText, activeCapability);
        const tokens = body.split(/(\s+)/);
        for (let i = 0; i < tokens.length; i++) {
          if (abortController.signal.aborted) throw new DOMException("Aborted", "AbortError");
          appendChunk(tokens[i]);
          await new Promise(r => setTimeout(r, 12 + Math.random() * 20));
        }

        finalize();
        return;
      }

      const response = await fetch(cfg.endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + cfg.key
        },
        body: JSON.stringify({
          model: cfg.model,
          messages: apiMessages,
          stream: true,
          temperature: 0.7,
          max_tokens: 2048
        }),
        signal: abortController.signal
      });

      if (!response.ok) {
        const errBody = await response.text();
        let msg = "HTTP " + response.status;
        try {
          const parsed = JSON.parse(errBody);
          if (parsed.error && parsed.error.message) msg = parsed.error.message;
        } catch (_) {}
        throw new Error(msg);
      }

      if (!response.body) throw new Error("Streaming not supported.");

      const reader = response.body.getReader();
      const decoder = new TextDecoder("utf-8");
      let buffer = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        if (!firstChunkSeen) {
          firstChunkSeen = true;
          updateTelemetryLatency(performance.now() - requestStartTime);
        }

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n");
        buffer = lines.pop() || "";

        for (let i = 0; i < lines.length; i++) {
          const line = lines[i].trim();
          if (!line || !line.startsWith("data:")) continue;
          const payload = line.slice(5).trim();
          if (!payload || payload === "[DONE]") continue;

          let parsed;
          try { parsed = JSON.parse(payload); } catch (_) { continue; }

          const delta = parsed.choices && parsed.choices[0] && parsed.choices[0].delta;
          if (!delta || typeof delta.content !== "string" || delta.content.length === 0) continue;

          appendChunk(delta.content);
        }
      }

      finalize();

    } catch (err) {
      if (err.name === "AbortError") {
        stopTpsLoop();
        isStreaming = false;
        abortController = null;
        updateSendState();
        return;
      }

      if (dots.parentNode) dots.remove();

      let friendly;
      if (/Failed to fetch|NetworkError|CORS/i.test(err.message)) {
        friendly = "Network / CORS error: the browser could not reach the API. Groq blocks direct browser calls — serve this file behind a local proxy. Details: " + err.message;
      } else if (/401|unauthorized|invalid.*key/i.test(err.message)) {
        friendly = "Authentication failed. Check your Groq API key in Settings.";
      } else if (/429|rate/i.test(err.message)) {
        friendly = "Rate limit reached. Groq free tier: ~30 req/min, 1,000 req/day per model. Wait and retry.";
      } else if (/model/i.test(err.message)) {
        friendly = "Model error: " + err.message;
      } else {
        friendly = "API error: " + err.message;
      }

      streamTarget.textContent = friendly;
      session.messages.push({ role: "assistant", text: friendly });
      persistChatHistory();
      updateTelemetrySessionTokens();

    } finally {
      stopTpsLoop();
      isStreaming = false;
      abortController = null;
      updateSendState();
      scrollToBottom();
    }
  }

  /* =========================================================================
     DOWNLOAD — standalone HTML export with Markdown-rendered content
     ========================================================================= */
  function downloadSourceFile() {
    const session = getActiveSession();
    const snapshot = session ? JSON.parse(JSON.stringify(session)) : { messages: [] };

    const htmlShell =
      "<!DOCTYPE html>\n" +
      "<html lang=\"en\"><head><meta charset=\"UTF-8\">" +
      "<title>ApexGPT — Conversation Export</title>" +
      "<style>" +
      "body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;background:#080a0f;color:#f2f4f9;padding:40px;max-width:840px;margin:0 auto;line-height:1.7}" +
      "h1{font-size:24px;margin-bottom:4px;background:linear-gradient(90deg,#f2f4f9,#a8b4ff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}" +
      ".meta{color:#5a6378;font-size:13px;margin-bottom:24px}" +
      ".msg{margin-bottom:20px;padding:16px 18px;border-radius:10px;border:1px solid #232838}" +
      ".msg.user{background:#141821}.msg.assistant{background:#0f121a}" +
      ".role{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#5a6378;margin-bottom:6px}" +
      ".body{white-space:pre-wrap;word-break:break-word;font-size:14px}" +
      "pre{background:#0a0d13;border:1px solid #232838;border-radius:8px;padding:14px;font-family:monospace;font-size:12px;overflow-x:auto;color:#b8c4d8}" +
      "</style></head><body>" +
      "<h1>ApexGPT — Peak Multimodal Intelligence Studio</h1>" +
      "<div class=\"meta\">Title: " + escapeHtml(session ? session.title : "Empty") +
      " &middot; Exported: " + new Date().toISOString() + "</div>";

    let bodyHtml = "";
    if (snapshot.messages && snapshot.messages.length > 0) {
      snapshot.messages.forEach(m => {
        bodyHtml +=
          "<div class=\"msg " + m.role + "\">" +
          "<div class=\"role\">" + (m.role === "user" ? "You" : "ApexGPT") + "</div>" +
          "<div class=\"body\">" + escapeHtml(m.text) + "</div>" +
          "</div>";
      });
    } else {
      bodyHtml = "<p class=\"meta\">(Empty conversation)</p>";
    }

    const fullDoc = htmlShell + bodyHtml + "</body></html>";

    const blob = new Blob([fullDoc], { type: "text/html;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "apexgpt-workspace-" + Date.now() + ".html";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function toggleSidebar() {
    dom.sidebar.classList.toggle("open");
  }

  dom.modalBackdrop.addEventListener("click", (e) => {
    if (e.target === dom.modalBackdrop) toggleModal(false);
  });

  window.startNewSession    = startNewSession;
  window.toggleSidebar      = toggleSidebar;
  window.toggleModal        = toggleModal;
  window.saveSettings       = saveSettings;
  window.sendMessage        = sendMessage;
  window.handleKeyPress     = handleKeyPress;
  window.autoResize         = autoResize;
  window.downloadSourceFile = downloadSourceFile;
  window.switchCapability   = switchCapability;

  /* =========================================================================
     BOOT SEQUENCE
     ========================================================================= */
  window.addEventListener("load", () => {
    loadChatHistory();

    if (chatHistory.length === 0) {
      startNewSession();
    } else {
      currentSessionId = chatHistory[0].id;
      dom.workspaceTitle.textContent = chatHistory[0].title || "New Conversation";
      renderSidebar();
      renderSessionMessages();
      updateTelemetrySessionTokens();
    }

    switchCapability("reasoning");
    updateApiStatus();
    updateSendState();
    updateTelemetryLatency(0);
    updateTelemetryTps(0);
    autoResize();
    dom.input.focus();
  });

  window.addEventListener("beforeunload", () => {
    if (abortController) abortController.abort();
  });

})();
</script>
</body>
</html>
